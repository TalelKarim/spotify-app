@startuml
title Track Play Flow

actor User
participant "React SPA" as SPA
participant "API Gateway" as APIGW
participant "Cognito Authorizer" as COG
participant "api_start_stream" as START
database "DynamoDB Tracks" as TRACKS
queue "EventBridge Bus" as EB
queue "SQS Listening Events" as SQS
participant "event_store_listening_event" as STORE
participant "event_update_track_stats" as EVTSTATS
participant "Step Functions\nListening Analytics" as SFN
participant "orch_update_track_stats" as ORCHTRACK
participant "orch_update_user_stats" as ORCHUSER
participant "orch_compute_analytics" as ORCHANALYTICS
database "DynamoDB Listening Events" as EVENTS
database "DynamoDB Users" as USERS
database "DynamoDB Analytics" as ANALYTICS

User -> SPA : Click Play
SPA -> APIGW : POST /tracks/{trackId}/play
APIGW -> COG : Validate JWT
COG --> APIGW : Claims
APIGW -> START : Proxy request
START -> TRACKS : Get track metadata
TRACKS --> START : Track item
START -> START : Generate correlationId
START -> EB : Put TrackPlayed event
START --> APIGW : 202 Accepted
APIGW --> SPA : Track play registered

par Event fan-out to SQS
  EB -> SQS : Route TrackPlayed
  SQS -> STORE : Deliver event batch
  STORE -> EVENTS : Persist raw listening event
  STORE --> SQS : Ack

  SQS -> EVTSTATS : Deliver event batch
  EVTSTATS -> TRACKS : Increment plays, set lastPlayedAt
  EVTSTATS --> SQS : Ack
else Event fan-out to Step Functions
  EB -> SFN : Start execution
  SFN -> ORCHTRACK : UpdateTrackStats
  ORCHTRACK -> TRACKS : Increment plays, set lastPlayedAt
  SFN -> ORCHUSER : UpdateUserStats
  ORCHUSER -> USERS : Increment totalPlays, set lastPlayedTrack
  SFN -> ORCHANALYTICS : ComputeAnalytics
  ORCHANALYTICS -> ANALYTICS : Increment dailyPlays
end

@enduml